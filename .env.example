# Razorpay API keys: Dashboard → Account & Settings → API Keys
# Use rzp_test_... keys while testing, then switch to rzp_live_... keys.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Consultation fee in paise (29900 = ₹299). Keep CONFIG.fee in script.js in sync.
CONSULT_FEE_PAISE=29900

# Payment confirmation emails (https://resend.com → API Keys).
# Without your own verified domain, Resend only delivers to the email you signed up with.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
NOTIFY_EMAIL=you@example.com
# Optional, once you verify a domain in Resend:
# NOTIFY_FROM=Doctor Sahiba Bookings <bookings@yourdomain.com>
